# Telegram
TELEGRAM_BOT_TOKEN=           # From @BotFather
TELEGRAM_OWNER_CHAT_ID=       # Champ's Telegram user ID (send /start to @userinfobot)

# Google Gemini
GEMINI_API_KEY=               # From aistudio.google.com/app/apikey

# Firebase (up-level-guild project)
FIREBASE_PROJECT_ID=up-level-guild
FIREBASE_CLIENT_EMAIL=        # from service-account.json -> client_email
FIREBASE_PRIVATE_KEY=         # from service-account.json -> private_key (include -----BEGIN/END lines)

# App
NODE_ENV=production
MAX_MEMORY_MESSAGES=20
PORT=3000

# Google OAuth2 (Gmail + Calendar) — optional
# 1. Go to console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: https://YOUR-RAILWAY-URL.up.railway.app/oauth/callback
# 4. Enable Gmail API and Google Calendar API in the project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use http://localhost — no server needed, Champ pastes code manually via /code command
GOOGLE_REDIRECT_URI=http://localhost
