# Telegram
TELEGRAM_BOT_TOKEN=           # From @BotFather
TELEGRAM_OWNER_CHAT_ID=       # Champ's Telegram user ID (send /start to @userinfobot)

# Google Gemini
GEMINI_API_KEY=               # From aistudio.google.com/app/apikey

# Firebase (up-level-guild project)
FIREBASE_PROJECT_ID=up-level-guild
FIREBASE_CLIENT_EMAIL=        # from service-account.json -> client_email
FIREBASE_PRIVATE_KEY=         # from service-account.json -> private_key (include -----BEGIN/END lines)

# App
NODE_ENV=production
MAX_MEMORY_MESSAGES=20
PORT=3000
